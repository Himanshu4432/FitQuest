rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is string);
    }

    // --- VALIDATION BLUEPRINTS (ANTI-UPDATE-GAP) ---

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 24 &&
             data.avatarId is string && data.avatarId.size() >= 1 && data.avatarId.size() <= 30 &&
             isStringList(data.interests, 10) &&
             data.dailyStepGoal is int && data.dailyStepGoal >= 1000 && data.dailyStepGoal <= 100000 &&
             data.dailyWaterGoalMl is int && data.dailyWaterGoalMl >= 500 && data.dailyWaterGoalMl <= 10000 &&
             data.dailyRunGoalKm is number && data.dailyRunGoalKm >= 0.5 && data.dailyRunGoalKm <= 100 &&
             data.dailySportsGoalMin is int && data.dailySportsGoalMin >= 5 && data.dailySportsGoalMin <= 360 &&
             data.totalXp is int && data.totalXp >= 0 && data.totalXp <= 10000000 &&
             data.level is int && data.level >= 1 && data.level <= 500 &&
             data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 10000 &&
             data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= 10000 &&
             data.longestRunKm is number && data.longestRunKm >= 0 && data.longestRunKm <= 500 &&
             data.bestDailyScore is int && data.bestDailyScore >= 0 && data.bestDailyScore <= 1000 &&
             data.totalActivities is int && data.totalActivities >= 0 && data.totalActivities <= 100000 &&
             data.totalStepsLifetime is int && data.totalStepsLifetime >= 0 && data.totalStepsLifetime <= 1000000000 &&
             isStringList(data.unlockedBadges, 30) &&
             isStringList(data.activeDates, 366) &&
             (!('lastActiveDate' in data) || data.lastActiveDate == null || (data.lastActiveDate is string && data.lastActiveDate.size() <= 16)) &&
             data.onboardingCompleted is bool &&
             data.publicProfile is bool &&
             data.notificationsEnabled is bool &&
             data.region is string && data.region.size() >= 1 && data.region.size() <= 40 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPublicProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 24 &&
             data.usernameLower is string && data.usernameLower.size() >= 3 && data.usernameLower.size() <= 24 &&
             data.avatarId is string && data.avatarId.size() >= 1 && data.avatarId.size() <= 30 &&
             data.region is string && data.region.size() >= 1 && data.region.size() <= 40 &&
             data.totalXp is int && data.totalXp >= 0 && data.totalXp <= 10000000 &&
             data.weeklyXp is int && data.weeklyXp >= 0 && data.weeklyXp <= 1000000 &&
             data.weeklyRunningKm is number && data.weeklyRunningKm >= 0 && data.weeklyRunningKm <= 2000 &&
             data.weeklySteps is int && data.weeklySteps >= 0 && data.weeklySteps <= 2000000 &&
             data.weeklySportsMinutes is int && data.weeklySportsMinutes >= 0 && data.weeklySportsMinutes <= 10080 &&
             data.todayHealthScore is int && data.todayHealthScore >= 0 && data.todayHealthScore <= 1000 &&
             data.level is int && data.level >= 1 && data.level <= 500 &&
             data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 10000 &&
             data.badgeCount is int && data.badgeCount >= 0 && data.badgeCount <= 30 &&
             isStringList(data.unlockedBadges, 30) &&
             data.publicProfile is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidDailyLog(data) {
      return data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.steps is int && data.steps >= 0 && data.steps <= 200000 &&
             data.waterMl is int && data.waterMl >= 0 && data.waterMl <= 20000 &&
             data.runningKm is number && data.runningKm >= 0 && data.runningKm <= 300 &&
             data.sportsMinutes is int && data.sportsMinutes >= 0 && data.sportsMinutes <= 1440 &&
             data.completedChallengeCount is int && data.completedChallengeCount >= 0 && data.completedChallengeCount <= 20 &&
             data.healthScore is int && data.healthScore >= 0 && data.healthScore <= 1000 &&
             data.xpEarnedToday is int && data.xpEarnedToday >= 0 && data.xpEarnedToday <= 50000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidActivityLog(data) {
      return data.activityType is string &&
             data.activityType in ['WALKING', 'RUNNING', 'CYCLING', 'FOOTBALL', 'CRICKET', 'BADMINTON', 'GYM', 'OTHER'] &&
             data.durationSeconds is int && data.durationSeconds >= 1 && data.durationSeconds <= 86400 &&
             data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 500 &&
             data.calories is int && data.calories >= 0 && data.calories <= 20000 &&
             data.stepsEstimated is int && data.stepsEstimated >= 0 && data.stepsEstimated <= 200000 &&
             data.xpEarned is int && data.xpEarned >= 0 && data.xpEarned <= 10000 &&
             data.personalBest is bool &&
             data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidWaterLog(data) {
      return data.amountMl is int && data.amountMl >= 50 && data.amountMl <= 5000 &&
             data.xpEarned is int && data.xpEarned >= 0 && data.xpEarned <= 500 &&
             data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             isValidTimestamp(data.createdAt);
    }

    function isValidFriendLink(data) {
      return data.friendUid is string && data.friendUid.size() >= 1 && data.friendUid.size() <= 128 &&
             data.friendUsername is string && data.friendUsername.size() >= 3 && data.friendUsername.size() <= 24 &&
             data.friendAvatarId is string && data.friendAvatarId.size() >= 1 && data.friendAvatarId.size() <= 30 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidChallenge(data) {
      return data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128 &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 80 &&
             data.description is string && data.description.size() <= 200 &&
             data.challengeType is string && data.challengeType in ['DAILY', 'WEEKLY', 'FRIEND_BATTLE', 'TEAM'] &&
             data.metricType is string && data.metricType in ['STEPS', 'RUNNING_KM', 'ACTIVE_MINUTES', 'WATER_ML', 'XP'] &&
             data.targetValue is int && data.targetValue >= 1 && data.targetValue <= 1000000 &&
             data.rewardXp is int && data.rewardXp >= 10 && data.rewardXp <= 10000 &&
             data.durationDays is int && data.durationDays >= 1 && data.durationDays <= 30 &&
             data.status is string && data.status in ['ACTIVE', 'COMPLETED'] &&
             data.publicChallenge is bool &&
             isStringList(data.participantIds, 50) && data.participantIds.size() >= 1 &&
             data.combinedProgress is int && data.combinedProgress >= 0 && data.combinedProgress <= 10000000 &&
             data.teamName is string && data.teamName.size() <= 40 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidFeedPost(data) {
      return data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorUsername is string && data.authorUsername.size() >= 3 && data.authorUsername.size() <= 24 &&
             data.authorAvatarId is string && data.authorAvatarId.size() >= 1 && data.authorAvatarId.size() <= 30 &&
             data.message is string && data.message.size() >= 3 && data.message.size() <= 200 &&
             data.category is string && data.category in ['RUN', 'SPORT', 'WATER', 'BADGE', 'CHALLENGE', 'STREAK'] &&
             data.xpEarned is int && data.xpEarned >= 0 && data.xpEarned <= 10000 &&
             data.publicFeed is bool &&
             data.fireCount is int && data.fireCount >= 0 && data.fireCount <= 100000 &&
             data.clapCount is int && data.clapCount >= 0 && data.clapCount <= 100000 &&
             data.boltCount is int && data.boltCount >= 0 && data.boltCount <= 100000 &&
             isStringList(data.reactedUserIds, 100) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- 1. PRIVATE USER PROFILE & SUBCOLLECTIONS ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'username', 'avatarId', 'interests',
                         'dailyStepGoal', 'dailyWaterGoalMl', 'dailyRunGoalKm', 'dailySportsGoalMin',
                         'totalXp', 'level', 'currentStreak', 'bestStreak',
                         'longestRunKm', 'bestDailyScore', 'totalActivities', 'totalStepsLifetime',
                         'unlockedBadges', 'activeDates', 'onboardingCompleted',
                         'publicProfile', 'notificationsEnabled', 'region', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'username', 'avatarId', 'interests',
                         'dailyStepGoal', 'dailyWaterGoalMl', 'dailyRunGoalKm', 'dailySportsGoalMin',
                         'totalXp', 'level', 'currentStreak', 'bestStreak',
                         'longestRunKm', 'bestDailyScore', 'totalActivities', 'totalStepsLifetime',
                         'unlockedBadges', 'activeDates', 'lastActiveDate', 'onboardingCompleted',
                         'publicProfile', 'notificationsEnabled', 'region', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'username', 'avatarId', 'interests',
                         'dailyStepGoal', 'dailyWaterGoalMl', 'dailyRunGoalKm', 'dailySportsGoalMin',
                         'totalXp', 'level', 'currentStreak', 'bestStreak',
                         'longestRunKm', 'bestDailyScore', 'totalActivities', 'totalStepsLifetime',
                         'unlockedBadges', 'activeDates', 'lastActiveDate', 'onboardingCompleted',
                         'publicProfile', 'notificationsEnabled', 'region', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      // Subcollection: Daily Logs
      match /daily_logs/{dateKey} {
        allow get: if isOwner(userId) && isValidId(dateKey);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(dateKey) &&
                         incoming().dateKey == dateKey &&
                         incoming().keys().hasAll([
                           'dateKey', 'steps', 'waterMl', 'runningKm', 'sportsMinutes',
                           'completedChallengeCount', 'healthScore', 'xpEarnedToday', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'dateKey', 'steps', 'waterMl', 'runningKm', 'sportsMinutes',
                           'completedChallengeCount', 'healthScore', 'xpEarnedToday', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidDailyLog(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(dateKey) &&
                         isValidDailyLog(incoming()) &&
                         incoming().dateKey == existing().dateKey &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'steps', 'waterMl', 'runningKm', 'sportsMinutes',
                           'completedChallengeCount', 'healthScore', 'xpEarnedToday', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(dateKey);
      }

      // Subcollection: Activity Logs
      match /activities/{activityId} {
        allow get: if isOwner(userId) && isValidId(activityId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(activityId) &&
                         incoming().keys().hasAll([
                           'activityType', 'durationSeconds', 'distanceKm', 'calories',
                           'stepsEstimated', 'xpEarned', 'personalBest', 'dateKey', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'activityType', 'durationSeconds', 'distanceKm', 'calories',
                           'stepsEstimated', 'xpEarned', 'personalBest', 'dateKey', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidActivityLog(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(activityId) &&
                         isValidActivityLog(incoming()) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'activityType', 'durationSeconds', 'distanceKm', 'calories',
                           'stepsEstimated', 'xpEarned', 'personalBest', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(activityId);
      }

      // Subcollection: Water Logs
      match /water_logs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().keys().hasAll(['amountMl', 'xpEarned', 'dateKey', 'createdAt']) &&
                         incoming().keys().hasOnly(['amountMl', 'xpEarned', 'dateKey', 'createdAt']) &&
                         isValidWaterLog(incoming());

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // Subcollection: Saved Friends
      match /friends/{friendUid} {
        allow get: if isOwner(userId) && isValidId(friendUid);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(friendUid) &&
                         incoming().friendUid == friendUid &&
                         incoming().keys().hasAll(['friendUid', 'friendUsername', 'friendAvatarId', 'createdAt']) &&
                         incoming().keys().hasOnly(['friendUid', 'friendUsername', 'friendAvatarId', 'createdAt']) &&
                         isValidFriendLink(incoming());

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(friendUid);
      }
    }

    // --- 2. PUBLIC NON-PII LEADERBOARD & DISCOVERY PROFILES ---
    match /public_profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || existing().publicProfile == true);
      allow list: if isSignedIn() && resource.data.publicProfile == true;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'username', 'usernameLower', 'avatarId', 'region',
                         'totalXp', 'weeklyXp', 'weeklyRunningKm', 'weeklySteps', 'weeklySportsMinutes',
                         'todayHealthScore', 'level', 'currentStreak', 'badgeCount', 'unlockedBadges',
                         'publicProfile', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'username', 'usernameLower', 'avatarId', 'region',
                         'totalXp', 'weeklyXp', 'weeklyRunningKm', 'weeklySteps', 'weeklySportsMinutes',
                         'todayHealthScore', 'level', 'currentStreak', 'badgeCount', 'unlockedBadges',
                         'publicProfile', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidPublicProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidPublicProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'username', 'usernameLower', 'avatarId', 'region',
                         'totalXp', 'weeklyXp', 'weeklyRunningKm', 'weeklySteps', 'weeklySportsMinutes',
                         'todayHealthScore', 'level', 'currentStreak', 'badgeCount', 'unlockedBadges',
                         'publicProfile', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // --- 3. CHALLENGES & COMPETITIONS ---
    match /challenges/{challengeId} {
      allow get: if isSignedIn() && isValidId(challengeId) &&
                    (existing().publicChallenge == true || request.auth.uid in existing().participantIds);
      allow list: if isSignedIn() &&
                     (resource.data.publicChallenge == true || request.auth.uid in resource.data.participantIds);

      allow create: if isSignedIn() &&
                       isValidId(challengeId) &&
                       incoming().creatorId == request.auth.uid &&
                       request.auth.uid in incoming().participantIds &&
                       incoming().status == 'ACTIVE' &&
                       incoming().keys().hasAll([
                         'creatorId', 'title', 'description', 'challengeType', 'metricType',
                         'targetValue', 'rewardXp', 'durationDays', 'status', 'publicChallenge',
                         'participantIds', 'combinedProgress', 'teamName', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'creatorId', 'title', 'description', 'challengeType', 'metricType',
                         'targetValue', 'rewardXp', 'durationDays', 'status', 'publicChallenge',
                         'participantIds', 'combinedProgress', 'teamName', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidChallenge(incoming());

      allow update: if isSignedIn() &&
                       isValidId(challengeId) &&
                       isValidChallenge(incoming()) &&
                       existing().status == 'ACTIVE' &&
                       incoming().creatorId == existing().creatorId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Join a public challenge
                         (
                           existing().publicChallenge == true &&
                           !(request.auth.uid in existing().participantIds) &&
                           request.auth.uid in incoming().participantIds &&
                           incoming().participantIds.size() == existing().participantIds.size() + 1 &&
                           incoming().participantIds.hasAll(existing().participantIds) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'updatedAt'])
                         ) ||
                         // Action 2: Participant logs progress or completes challenge
                         (
                           request.auth.uid in existing().participantIds &&
                           incoming().combinedProgress >= existing().combinedProgress &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['combinedProgress', 'status', 'updatedAt'])
                         ) ||
                         // Action 3: Creator invites another participant
                         (
                           existing().creatorId == request.auth.uid &&
                           incoming().participantIds.hasAll(existing().participantIds) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'updatedAt'])
                         )
                       );

      allow delete: if isSignedIn() && isValidId(challengeId) && existing().creatorId == request.auth.uid;
    }

    // --- 4. FRIENDS & SOCIAL ACTIVITY FEED ---
    match /feed_posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId) &&
                    (existing().publicFeed == true || existing().authorId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.publicFeed == true;

      allow create: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().fireCount == 0 &&
                       incoming().clapCount == 0 &&
                       incoming().boltCount == 0 &&
                       incoming().reactedUserIds.size() == 0 &&
                       incoming().keys().hasAll([
                         'authorId', 'authorUsername', 'authorAvatarId', 'message', 'category',
                         'xpEarned', 'publicFeed', 'fireCount', 'clapCount', 'boltCount',
                         'reactedUserIds', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'authorId', 'authorUsername', 'authorAvatarId', 'message', 'category',
                         'xpEarned', 'publicFeed', 'fireCount', 'clapCount', 'boltCount',
                         'reactedUserIds', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidFeedPost(incoming());

      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       isValidFeedPost(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Emoji reaction on a public feed post
                         existing().publicFeed == true &&
                         incoming().fireCount >= existing().fireCount &&
                         incoming().fireCount <= existing().fireCount + 1 &&
                         incoming().clapCount >= existing().clapCount &&
                         incoming().clapCount <= existing().clapCount + 1 &&
                         incoming().boltCount >= existing().boltCount &&
                         incoming().boltCount <= existing().boltCount + 1 &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'fireCount', 'clapCount', 'boltCount', 'reactedUserIds', 'updatedAt'
                         ])
                       );

      allow delete: if isSignedIn() && isValidId(postId) && existing().authorId == request.auth.uid;
    }
  }
}
